{
  "id": "generic_d20",
  "name": "Generic d20",
  "description": "Six abilities, skills and weapon attacks. Built in; use it as a starting point for your own format.",
  "derived": {
    "str_mod": "floor((str - 10) / 2)",
    "dex_mod": "floor((dex - 10) / 2)",
    "con_mod": "floor((con - 10) / 2)",
    "int_mod": "floor((int - 10) / 2)",
    "wis_mod": "floor((wis - 10) / 2)",
    "cha_mod": "floor((cha - 10) / 2)",
    "save_str": "str_mod + prof * sp_str",
    "save_dex": "dex_mod + prof * sp_dex",
    "save_con": "con_mod + prof * sp_con",
    "save_int": "int_mod + prof * sp_int",
    "save_wis": "wis_mod + prof * sp_wis",
    "save_cha": "cha_mod + prof * sp_cha",
    "skill_acrobatics": "dex_mod + prof * sk_acrobatics",
    "skill_athletics": "str_mod + prof * sk_athletics",
    "skill_arcana": "int_mod + prof * sk_arcana",
    "skill_history": "int_mod + prof * sk_history",
    "skill_insight": "wis_mod + prof * sk_insight",
    "skill_intimidation": "cha_mod + prof * sk_intimidation",
    "skill_investigation": "int_mod + prof * sk_investigation",
    "skill_perception": "wis_mod + prof * sk_perception",
    "skill_persuasion": "cha_mod + prof * sk_persuasion",
    "skill_stealth": "dex_mod + prof * sk_stealth",
    "skill_survival": "wis_mod + prof * sk_survival",
    "init": "dex_mod",
    "atk_str": "str_mod + prof",
    "atk_dex": "dex_mod + prof"
  },
