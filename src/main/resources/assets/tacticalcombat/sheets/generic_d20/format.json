  "derived": {
    "str_mod": "floor((str - 10) / 2)",
    "dex_mod": "floor((dex - 10) / 2)",
    "con_mod": "floor((con - 10) / 2)",
    "int_mod": "floor((int - 10) / 2)",
    "wis_mod": "floor((wis - 10) / 2)",
    "cha_mod": "floor((cha - 10) / 2)",
    "save_str": "str_mod + prof * sp_str",
    "save_dex": "dex_mod + prof * sp_dex",
    "save_con": "con_mod + prof * sp_con",
    "save_int": "int_mod + prof * sp_int",
    "save_wis": "wis_mod + prof * sp_wis",
    "save_cha": "cha_mod + prof * sp_cha",
    "skill_acrobatics": "floor(dex_mod + prof * sk_acrobatics)",
    "skill_athletics": "floor(str_mod + prof * sk_athletics)",
    "skill_arcana": "floor(int_mod + prof * sk_arcana)",
    "skill_history": "floor(int_mod + prof * sk_history)",
    "skill_insight": "floor(wis_mod + prof * sk_insight)",
    "skill_intimidation": "floor(cha_mod + prof * sk_intimidation)",
    "skill_investigation": "floor(int_mod + prof * sk_investigation)",
    "skill_perception": "floor(wis_mod + prof * sk_perception)",
    "skill_persuasion": "floor(cha_mod + prof * sk_persuasion)",
    "skill_stealth": "floor(dex_mod + prof * sk_stealth)",
    "skill_survival": "floor(wis_mod + prof * sk_survival)",
    "init": "dex_mod",
    "atk_str": "str_mod + prof",
    "atk_dex": "dex_mod + prof",
    "carry_cap": "str * 15"
  },
